# Example only. Configure this after creating the state bucket.
# Backend blocks cannot use variables.

terraform {
  backend "s3" {
    bucket       = "REPLACE_WITH_TERRAFORM_STATE_BUCKET"
    key          = "kubemind-ai-cicd/dev/terraform.tfstate"
    region       = "ap-south-1"
    encrypt      = true
    use_lockfile = true
  }
}
